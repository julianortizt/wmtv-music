{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix client",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://TU-BACKEND.example.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://TU-BACKEND.example.com/api/uploads/:path*"
    },
    {
      "source": "^/(?!api/|uploads/|assets/|_vercel/)(?!.*\\.[a-zA-Z0-9]+$).*$",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
